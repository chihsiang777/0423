# Server
PORT=3000
HOST=localhost

# Frontend dev server origin.
# Use http://localhost:5173 when running `bun run dev`.
# Use your deployed frontend URL in production.
API_ALLOWED_ORIGIN=http://localhost:5173

# Store driver: "postgres" for Neon/PostgreSQL, "json" for local JSON demo mode.
STORE_DRIVER=postgres

# Neon PostgreSQL connection strings.
# DATABASE_URL can use the pooled connection string.
# DATABASE_URL_MIGRATION should use the direct/non-pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_MIGRATION=postgresql://user:password@host/dbname?sslmode=require

# PostgreSQL schema namespace for this Better Auth version.
PG_SCHEMA=bf_v9

# Better Auth
# Local backend URL. In production, set this to your public backend URL.
BETTER_AUTH_URL=http://localhost:3000

# Replace with a strong random secret before starting the backend.
# Generate one with:
# bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-64-char-random-hex-secret

# Google OAuth provider
# Google Cloud Console redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Frontend
# Leave empty when the frontend is served by the same backend origin.
# For Vite dev, this points API calls to Elysia.
VITE_API_BASE_URL=http://localhost:3000
